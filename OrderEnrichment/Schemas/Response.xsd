<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.example.org/OrdersResponse"
           xmlns:tns="http://www.example.org/OrdersResponse"
           elementFormDefault="qualified">

  <xs:element name="OrdersResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="orderId" type="xs:string"></xs:element>
        <xs:element name="currency" type="xs:string"></xs:element>
        <xs:element name="totalAmount" type="xs:decimal"></xs:element>
        <xs:element name="fxRate" type="xs:decimal"></xs:element>
        <xs:element name="totalEUR" type="xs:decimal"></xs:element>
        <xs:element name="requestedDeliveryDate" type="xs:date"></xs:element>
        <xs:element name="effectiveDeliveryDate" type="xs:date"></xs:element>
        <xs:element name="deliveryShiftReason">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="HOLIDAY"></xs:enumeration>
                    <xs:enumeration value="WEEKEND"></xs:enumeration>
                    <xs:enumeration value="NONE"></xs:enumeration>
                </xs:restriction>
            </xs:simpleType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>