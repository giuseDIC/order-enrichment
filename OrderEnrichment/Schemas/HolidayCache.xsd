<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.example.org/HolidaysCache"
           xmlns:tns="http://www.example.org/HolidaysCache"
           xmlns:hr="http://www.example.org/HolidaysResponse"
           elementFormDefault="qualified">
  <xs:import namespace="http://www.example.org/HolidaysResponse"
             schemaLocation="HolidayResponse.xsd"/>
  <xs:element name="HolidaysCache">
    <xs:complexType><xs:sequence>
      <xs:element name="entry" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType><xs:sequence>
          <xs:element name="countryCode" type="xs:string"/>
          <xs:element name="year" type="xs:integer"/>
          <xs:element ref="hr:Holidays"/>
        </xs:sequence></xs:complexType>
      </xs:element>
    </xs:sequence></xs:complexType>
  </xs:element>
</xs:schema>