                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ResolveError/ns8:httpStatus = 502]]></bpws:transitionCondition>
                                    </bpws:source>
