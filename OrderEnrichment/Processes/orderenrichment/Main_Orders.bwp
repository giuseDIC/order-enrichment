    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>SetCorrelationId</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
                <variable>CallOrcOrders</variable>
            </endingVariables>
        </task>
        <task name="SetCorrelationId">
            <endingVariables>
                <variable>SetCorrelationId-input</variable>
            </endingVariables>
        </task>
        <task name="CallOrcOrders">
            <endingVariables>
                <variable>CallOrcOrders-input</variable>
                <variable>post</variable>
            </endingVariables>
        </task>
        <task name="flow3">
            <endingVariables>
                <variable>BuildError</variable>
                <variable>ResolveError</variable>
            </endingVariables>
        </task>
        <task name="ResolveError">
            <endingVariables>
                <variable>ResolveError-input</variable>
            </endingVariables>
        </task>
        <task name="LogError">
