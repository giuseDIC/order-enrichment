            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="tns:orders"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.example.org/OrdersResponse"/>
            <wsdl:import namespace="http://tns.tibco.com/bw/REST"/>
            <wsdl:import namespace="http://www.example.org/orders"/>
            <wsdl:import namespace="http://www.example.org/ErrorResponse"/>
            <wsdl:import namespace="http://xmlns.example.com/Main_Orders/parameters"/>
            <wsdl:import namespace="http://xmlns.example.com/Main_Orders/headerParameters"/>
            <wsdl:message name="postRequest">
                <wsdl:part element="extns2:orders" name="item" tibex:hasMultipleNamespaces="false"/>
                <wsdl:part element="extns5:ordersPostHeader"
                    name="httpHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="postResponse">
                <wsdl:part element="extns:OrdersResponse" name="item" tibex:hasMultipleNamespaces="false"/>
                <wsdl:part element="extns5:ordersPostResponseHeader"
                    name="httpResponseHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="post4XXFaultMessage">
                <wsdl:part element="extns1:client4XXError" name="clientError"/>
                <wsdl:part element="extns5:ordersPostResponseHeader"
                    name="httpFaultHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="post5XXFaultMessage">
                <wsdl:part element="extns1:server5XXError" name="serverError"/>
                <wsdl:part element="extns5:ordersPostResponseHeader"
                    name="httpFaultHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="post400FaultMessage">
                <wsdl:part element="extns3:ErrorResponse"
                    name="client-400-BadRequest"
                    tibex:reasonPhrase="Bad Request" tibex:statusCode="400"/>
                <wsdl:part element="extns5:ordersPostResponseHeader"
                    name="httpFaultHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="post502FaultMessage">
                <wsdl:part element="extns3:ErrorResponse"
                    name="server-502-BadGateway"
                    tibex:reasonPhrase="Bad Gateway" tibex:statusCode="502"/>
                <wsdl:part element="extns5:ordersPostResponseHeader"
                    name="httpFaultHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="post500FaultMessage">
                <wsdl:part element="extns3:ErrorResponse"
                    name="server-500-InternalServerError"
                    tibex:reasonPhrase="Internal Server Error" tibex:statusCode="500"/>
                <wsdl:part element="extns5:ordersPostResponseHeader"
                    name="httpFaultHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:portType name="orders" tibex:bw.rest.apipath="/orders"
                tibex:bw.rest.basepath="Main_Orders"
                tibex:bw.rest.resource="Service Descriptors/orderenrichment.Main_Orders-Main_Orders.json"
                tibex:bw.rest.resource.source="generated" tibex:source="bw.rest.service">
                <wsdl:documentation>Main_Orders service</wsdl:documentation>
                <wsdl:operation name="post">
                    <wsdl:documentation>postMain_Orders</wsdl:documentation>
                    <wsdl:input message="tns:postRequest" name="postInput"/>
                    <wsdl:output message="tns:postResponse" name="postOutput"/>
                    <wsdl:fault message="tns:post4XXFaultMessage" name="clientFault"/>
                    <wsdl:fault message="tns:post5XXFaultMessage" name="serverFault"/>
                    <wsdl:fault message="tns:post400FaultMessage" name="client-400-Fault"/>
                    <wsdl:fault message="tns:post502FaultMessage" name="server-502-Fault"/>
                    <wsdl:fault message="tns:post500FaultMessage" name="server-500-Fault"/>
                </wsdl:operation>
            </wsdl:portType>
        </wsdl:definitions>
