                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xmlns.example.com/20261007172436PLT&quot; xmlns:tns3=&quot;http://www.example.org/orders&quot; xmlns:tns2=&quot;http://www.example.org/OrdersResponse&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.example.org/FxRate&quot; xmlns:tns4=&quot;http://www.example.org/DeliveryDate&quot; xmlns:tns6=&quot;http://xmlns.example.com/Main_Orders/headerParameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CallOrcOrders&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:OrdersResponse>&#xa;            &lt;tns2:orderId>&#xa;                &lt;xsl:value-of select=&quot;$CallOrcOrders/tns2:orderId&quot;/>&#xa;            &lt;/tns2:orderId>&#xa;            &lt;tns2:currency>&#xa;                &lt;xsl:value-of select=&quot;$CallOrcOrders/tns2:currency&quot;/>&#xa;            &lt;/tns2:currency>&#xa;            &lt;tns2:totalAmount>&#xa;                &lt;xsl:value-of select=&quot;$CallOrcOrders/tns2:totalAmount&quot;/>&#xa;            &lt;/tns2:totalAmount>&#xa;            &lt;tns2:fxRate>&#xa;                &lt;xsl:value-of select=&quot;$CallOrcOrders/tns2:fxRate&quot;/>&#xa;            &lt;/tns2:fxRate>&#xa;            &lt;tns2:totalEUR>&#xa;                &lt;xsl:value-of select=&quot;$CallOrcOrders/tns2:totalEUR&quot;/>&#xa;            &lt;/tns2:totalEUR>&#xa;            &lt;tns2:requestedDeliveryDate>&#xa;                &lt;xsl:value-of select=&quot;$CallOrcOrders/tns2:requestedDeliveryDate&quot;/>&#xa;            &lt;/tns2:requestedDeliveryDate>&#xa;            &lt;tns2:effectiveDeliveryDate>&#xa;                &lt;xsl:value-of select=&quot;$CallOrcOrders/tns2:effectiveDeliveryDate&quot;/>&#xa;            &lt;/tns2:effectiveDeliveryDate>&#xa;            &lt;tns2:deliveryShiftReason>&#xa;                &lt;xsl:value-of select=&quot;$CallOrcOrders/tns2:deliveryShiftReason&quot;/>&#xa;            &lt;/tns2:deliveryShiftReason>&#xa;            &lt;xsl:for-each select=&quot;$CallOrcOrders/tns2:warnings&quot;>&#xa;                &lt;tns2:warnings>&#xa;                    &lt;xsl:copy-of select=&quot;./@xsi:nil&quot;/>&#xa;                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                &lt;/tns2:warnings>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns2:OrdersResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xmlns.example.com/20261007172436PLT&quot; xmlns:tns3=&quot;http://www.example.org/orders&quot; xmlns:tns2=&quot;http://www.example.org/OrdersResponse&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.example.org/FxRate&quot; xmlns:tns4=&quot;http://www.example.org/DeliveryDate&quot; xmlns:tns6=&quot;http://xmlns.example.com/Main_Orders/headerParameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SetCorrelationId&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:ordersPostResponseHeader>&#xa;            &lt;X-Correlation-Id>&#xa;                &lt;xsl:value-of select=&quot;$SetCorrelationId&quot;/>&#xa;            &lt;/X-Correlation-Id>&#xa;        &lt;/tns6:ordersPostResponseHeader>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://xmlns.example.com/20261007172436PLT" xmlns:tns3="http://www.example.org/orders" xmlns:tns2="http://www.example.org/OrdersResponse" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns5="http://www.example.org/FxRate" xmlns:tns4="http://www.example.org/DeliveryDate" xmlns:tns6="http://xmlns.example.com/Main_Orders/headerParameters" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;&lt;xsl:param name="SetCorrelationId"/&gt;&lt;xsl:param name="CallOrcOrders"/&gt;&lt;xsl:template name="postOut-input" match="/"&gt;&lt;tns1:postResponse&gt;&lt;item&gt;&lt;tns2:OrdersResponse&gt;&lt;tns2:orderId&gt;&lt;xsl:value-of select="$CallOrcOrders/tns2:orderId"/&gt;&lt;/tns2:orderId&gt;&lt;tns2:currency&gt;&lt;xsl:value-of select="$CallOrcOrders/tns2:currency"/&gt;&lt;/tns2:currency&gt;&lt;tns2:totalAmount&gt;&lt;xsl:value-of select="$CallOrcOrders/tns2:totalAmount"/&gt;&lt;/tns2:totalAmount&gt;&lt;tns2:fxRate&gt;&lt;xsl:value-of select="$CallOrcOrders/tns2:fxRate"/&gt;&lt;/tns2:fxRate&gt;&lt;tns2:totalEUR&gt;&lt;xsl:value-of select="$CallOrcOrders/tns2:totalEUR"/&gt;&lt;/tns2:totalEUR&gt;&lt;tns2:requestedDeliveryDate&gt;&lt;xsl:value-of select="$CallOrcOrders/tns2:requestedDeliveryDate"/&gt;&lt;/tns2:requestedDeliveryDate&gt;&lt;tns2:effectiveDeliveryDate&gt;&lt;xsl:value-of select="$CallOrcOrders/tns2:effectiveDeliveryDate"/&gt;&lt;/tns2:effectiveDeliveryDate&gt;&lt;tns2:deliveryShiftReason&gt;&lt;xsl:value-of select="$CallOrcOrders/tns2:deliveryShiftReason"/&gt;&lt;/tns2:deliveryShiftReason&gt;&lt;xsl:for-each select="$CallOrcOrders/tns2:warnings"&gt;&lt;tns2:warnings&gt;&lt;xsl:copy-of select="./@xsi:nil"/&gt;&lt;xsl:value-of select="."/&gt;&lt;/tns2:warnings&gt;&lt;/xsl:for-each&gt;&lt;/tns2:OrdersResponse&gt;&lt;/item&gt;&lt;httpResponseHeaders&gt;&lt;tns6:ordersPostResponseHeader&gt;&lt;X-Correlation-Id&gt;&lt;xsl:value-of select="$SetCorrelationId"/&gt;&lt;/X-Correlation-Id&gt;&lt;/tns6:ordersPostResponseHeader&gt;&lt;/httpResponseHeaders&gt;&lt;/tns1:postResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessTopostOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="if (string-length($post/httpHeaders/tns:ordersPostHeader/X-Correlation-Id) > 0) then $post/httpHeaders/tns:ordersPostHeader/X-Correlation-Id else concat('OE-', translate(string(current-dateTime()), '-:.T+', ''), '-', $_processContext/JobId)"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="SetCorrelationId-input"
                                    name="SetCorrelationId"
                                    outputVariable="SetCorrelationId"
                                    tibex:xpdlId="45e56b70-584a-465e-845a-14fc468c4494"
                                    type="bw.internal.setSharedVariable" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStartToSetSharedVariable"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SetCorrelationIdToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="if (string-length($post.httpHeaders/X-Correlation-Id) > 0) then $post.httpHeaders/X-Correlation-Id else concat('OE-', translate(string(current-dateTime()), '-:.T+', ''), '-', $_processContext/JobId)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:SetSharedVariable
                                    inline="true"
                                    variableName="correlationId" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/orders&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;CallOrcOrders-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$post/item/tns3:orders&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallOrcOrders-input"
                                    name="CallOrcOrders"
                                    outputVariable="CallOrcOrders"
                                    tibex:xpdlId="d572263b-2947-4f33-a579-1e4d341c4b7e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SetCorrelationIdToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessTopostOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/orders&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;CallOrcOrders-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$post.item&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="orderenrichment.Orc_Orders" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
