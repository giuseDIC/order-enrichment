        </schema>
        <wsdl:definitions
            targetNamespace="http://xmlns.example.com/20261007172436PLT"
            xmlns:extns="http://www.example.org/OrdersResponse"
            xmlns:extns1="http://tns.tibco.com/bw/REST"
