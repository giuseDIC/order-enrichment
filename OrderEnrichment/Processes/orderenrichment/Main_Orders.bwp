                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.keypartner.com/orderenrichment/InternalError&quot; xmlns:tns=&quot;http://www.example.org/ErrorResponse&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ErrorResponse&quot;/>&lt;xsl:template name=&quot;ResolveError-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$ErrorResponse/tns:code = 'VALIDATION_ERROR'&quot;>&lt;tns7:InternalError>&lt;tns7:internalCode>&lt;xsl:value-of select=&quot;'OE-001'&quot;/>&lt;/tns7:internalCode>&lt;tns7:httpStatus>&lt;xsl:value-of select=&quot;400&quot;/>&lt;/tns7:httpStatus>&lt;/tns7:InternalError>&lt;/xsl:when>&lt;xsl:when test=&quot;$ErrorResponse/tns:code = 'INVALID_CURRENCY'&quot;>&lt;tns7:InternalError>&lt;tns7:internalCode>&lt;xsl:value-of select=&quot;'OE-002'&quot;/>&lt;/tns7:internalCode>&lt;tns7:httpStatus>&lt;xsl:value-of select=&quot;400&quot;/>&lt;/tns7:httpStatus>&lt;/tns7:InternalError>&lt;/xsl:when>&lt;xsl:when test=&quot;$ErrorResponse/tns:code = 'UPSTREAM_FX_UNAVAILABLE'&quot;>&lt;tns7:InternalError>&lt;tns7:internalCode>&lt;xsl:value-of select=&quot;'OE-003'&quot;/>&lt;/tns7:internalCode>&lt;tns7:httpStatus>&lt;xsl:value-of select=&quot;502&quot;/>&lt;/tns7:httpStatus>&lt;/tns7:InternalError>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns7:InternalError>&lt;tns7:internalCode>&lt;xsl:value-of select=&quot;'OE-999'&quot;/>&lt;/tns7:internalCode>&lt;tns7:httpStatus>&lt;xsl:value-of select=&quot;500&quot;/>&lt;/tns7:httpStatus>&lt;/tns7:InternalError>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
