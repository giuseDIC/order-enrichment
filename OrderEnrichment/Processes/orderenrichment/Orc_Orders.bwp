    xmlns:tns="http://www.example.org/ErrorResponse" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <tibex:VariableDescriptor type="MemorySaving">
        <task name="flow">
            <endingVariables>
                <variable>CallValidateOrder</variable>
            </endingVariables>
        </task>
        <task name="End">
            <endingVariables>
                <variable>BuildOrderResponse</variable>
            </endingVariables>
        </task>
        <task name="CallValidateOrder">
            <endingVariables>
                <variable>CallValidateOrder-input</variable>
            </endingVariables>
        </task>
        <task name="ThrowValidator">
            <endingVariables>
                <variable>ThrowValidator-input</variable>
            </endingVariables>
        </task>
        <task name="CallDeliveryDate">
            <endingVariables>
                <variable>CallDeliveryDate-input</variable>
            </endingVariables>
        </task>
        <task name="CallFxRate">
            <endingVariables>
                <variable>CallFxRate-input</variable>
            </endingVariables>
        </task>
        <task name="BuildOrderResponse">
            <endingVariables>
                <variable>BuildOrderResponse-input</variable>
                <variable>Start</variable>
                <variable>CallDeliveryDate</variable>
                <variable>CallFxRate</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
    <tibex:Types>
        <xs:schema attributeFormDefault="unqualified"
            elementFormDefault="qualified"
            targetNamespace="http://www.tibco.com/pe/EngineTypes"
            xmlns:tns="http://www.tibco.com/pe/EngineTypes" xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:complexType block="extension restriction"
