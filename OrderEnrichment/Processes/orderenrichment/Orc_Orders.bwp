            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns1:OrdersResponse" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns0:orders"
            name="CallValidateOrder-input" sca-bpel:internal="true"/>
        <bpws:variable element="tns:ErrorResponse"
            name="CallValidateOrder" sca-bpel:internal="true"/>
        <bpws:variable element="tns:ErrorResponse"
            name="ThrowValidator-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:DeliveryDateRequest"
            name="CallDeliveryDate-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:DeliveryDateResult"
            name="CallDeliveryDate" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:FxRateRequest"
            name="CallFxRate-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:FxRateResult" name="CallFxRate" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:OrdersResponse"
            name="BuildOrderResponse-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:OrdersResponse"
            name="BuildOrderResponse" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallValidatorOrder" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallValidatorOrderToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallValidatorOrderToCallProcess1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcess1ToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallValidateOrderToThrow" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="556d75c7-6e01-485b-b21c-bd969e28f8d9"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallValidatorOrder"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End" tibex:copyOf="BuildOrderResponse"
                    tibex:xpdlId="e3cd0d66-5c9d-44fb-84bf-83e07ea26f66" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/OrdersResponse&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;BuildOrderResponse&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$BuildOrderResponse&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="CallValidateOrder-input"
                    name="CallValidateOrder"
                    outputVariable="CallValidateOrder"
                    tibex:xpdlId="7e7d5f47-36de-4028-ad9b-3f3e514a861a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallValidatorOrder"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallValidatorOrderToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="not(exists($CallValidateOrder/tns:details))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[not(exists($CallValidateOrder/tns:details))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallValidatorOrderToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="not(exists($CallValidateOrder/tns:details))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[not(exists($CallValidateOrder/tns:details))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallValidateOrderToThrow">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($CallValidateOrder/tns:details/tns:field) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($CallValidateOrder/tns:details/tns:field) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/orders&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallValidateOrder-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:orders>&#xa;            &lt;xsl:if test=&quot;$Start/tns2:orderId&quot;>&#xa;                &lt;tns2:orderId>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:orderId&quot;/>&#xa;                &lt;/tns2:orderId>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns2:countryCode&quot;>&#xa;                &lt;tns2:countryCode>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:countryCode&quot;/>&#xa;                &lt;/tns2:countryCode>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns2:currency&quot;>&#xa;                &lt;tns2:currency>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:currency&quot;/>&#xa;                &lt;/tns2:currency>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns2:requestedDeliveryDate&quot;>&#xa;                &lt;tns2:requestedDeliveryDate>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:requestedDeliveryDate&quot;/>&#xa;                &lt;/tns2:requestedDeliveryDate>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:copy-of select=&quot;$Start/tns2:items&quot;/>&#xa;        &lt;/tns2:orders>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="orderenrichment.ValidateOrder" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:throw faultName="tns:ErrorResponse"
                faultVariable="ThrowValidator-input"
                name="ThrowValidator" tibex:xpdlId="fb8dfd00-8f2c-4b45-8302-b7e225f18473">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ErrorResponse&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CallValidateOrder&quot;/>&lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&lt;tns:ErrorResponse>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;VALIDATION_ERROR&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:message>&lt;xsl:value-of select=&quot;$CallValidateOrder/tns:message&quot;/>&lt;/tns:message>&lt;xsl:copy-of select=&quot;$CallValidateOrder/tns:details&quot;/>&lt;/tns:ErrorResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallValidateOrderToThrow"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="CallDeliveryDate-input"
                    name="CallDeliveryDate"
                    outputVariable="CallDeliveryDate"
                    tibex:xpdlId="dc950685-ae92-4b72-9163-27ade526c4c4"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallValidatorOrderToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/orders&quot; xmlns:tns1=&quot;http://www.example.org/DeliveryDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallDeliveryDate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DeliveryDateRequest>&#xa;            &lt;tns1:countryCode>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:countryCode&quot;/>&#xa;            &lt;/tns1:countryCode>&#xa;            &lt;tns1:requestedDeliveryDate>&#xa;                &lt;xsl:value-of select=&quot;xsd:date($Start/tns2:requestedDeliveryDate)&quot;/>&#xa;            &lt;/tns1:requestedDeliveryDate>&#xa;        &lt;/tns1:DeliveryDateRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="orderenrichment.At_DeliveryDate" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="CallFxRate-input"
                    name="CallFxRate" outputVariable="CallFxRate"
                    tibex:xpdlId="11a45a03-897e-4348-926a-aef3d817e48f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallValidatorOrderToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess1ToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/orders&quot; xmlns:tns4=&quot;http://www.example.org/FxRate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallFxRate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:FxRateRequest>&#xa;            &lt;tns4:currency>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:currency&quot;/>&#xa;            &lt;/tns4:currency>&#xa;        &lt;/tns4:FxRateRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="orderenrichment.At_FxRate" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="30e08403-700b-4340-beff-810e3531968a">
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToEmpty"/>
                    <bpws:target linkName="CallProcessToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToMapper"/>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="BuildOrderResponse-input"
                    name="BuildOrderResponse"
                    outputVariable="BuildOrderResponse"
                    tibex:xpdlId="a7179609-e997-43f5-839e-df22fb15c5b0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/orders&quot; xmlns:tns3=&quot;http://www.example.org/OrdersResponse&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/DeliveryDate&quot; xmlns:tns4=&quot;http://www.example.org/FxRate&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CallDeliveryDate&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;CallFxRate&quot;/>&lt;xsl:template name=&quot;BuildOrderResponse-input&quot; match=&quot;/&quot;>&lt;tns3:OrdersResponse>&lt;tns3:orderId>&lt;xsl:value-of select=&quot;$Start/tns2:orderId&quot;/>&lt;/tns3:orderId>&lt;tns3:currency>&lt;xsl:value-of select=&quot;$Start/tns2:currency&quot;/>&lt;/tns3:currency>&lt;tns3:totalAmount>&lt;xsl:value-of select=&quot;round(sum(for $x in $Start/tns2:items return $x/tns2:qty * $x/tns2:unitPrice) * 100) div 100&amp;#xD;&amp;#xA;&quot;/>&lt;/tns3:totalAmount>&lt;tns3:fxRate>&lt;xsl:value-of select=&quot;$CallFxRate/tns4:fxRate&quot;/>&lt;/tns3:fxRate>&lt;tns3:totalEUR>&lt;xsl:value-of select=&quot;round(round(sum(for $x in $Start/tns2:items return $x/tns2:qty * $x/tns2:unitPrice) * 100) div 100 * $CallFxRate/tns4:fxRate * 100) div 100&quot;/>&lt;/tns3:totalEUR>&lt;tns3:requestedDeliveryDate>&lt;xsl:value-of select=&quot;xsd:date($Start/tns2:requestedDeliveryDate)&quot;/>&lt;/tns3:requestedDeliveryDate>&lt;tns3:effectiveDeliveryDate>&lt;xsl:value-of select=&quot;$CallDeliveryDate/tns1:effectiveDeliveryDate&quot;/>&lt;/tns3:effectiveDeliveryDate>&lt;tns3:deliveryShiftReason>&lt;xsl:value-of select=&quot;$CallDeliveryDate/tns1:deliveryShiftReason&quot;/>&lt;/tns3:deliveryShiftReason>&lt;xsl:for-each select=&quot;$CallDeliveryDate/tns1:warnings&quot;>&lt;tns3:warnings>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns3:warnings>&lt;/xsl:for-each>&lt;/tns3:OrdersResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:OrdersResponse="http://www.example.org/OrdersResponse"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="OrdersResponse:OrdersResponse" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
