<?xml version="1.0" encoding="UTF-8"?>
<bpws:process exitOnStandardFault="no"
    name="orderenrichment.At_DeliveryDate" suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20261008121516"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns0="http://www.example.org/DeliveryDate"
    xmlns:ns1="http://tns.tibco.com/bw/activity/sendhttprequest/input+97a97cc8-f18c-4e3d-ad8e-da0ba1ea004b+RequestActivityInput"
    xmlns:ns2="http://tns.tibco.com/bw/activity/sendhttprequest/output+97a97cc8-f18c-4e3d-ad8e-da0ba1ea004b+RequestActivityOutput"
    xmlns:ns3="http://tns.tibco.com/bw/palette/internal/activityerror+bw.http.sendHTTPRequest"
    xmlns:ns4="activity.jsonParser.input+8528dbeb-c808-4716-92a0-1dd19df971e1+ActivityInputType"
    xmlns:ns5="http://tns.tibco.com/bw/palette/internal/activityerror+bw.restjson.JsonParser"
    xmlns:ns6="http://www.tibco.com/pe/WriteToLogActivitySchema"
