    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/DeliveryDate"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/HolidaysResponse"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/HolidaysRequest"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:DeliveryDateRequest" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:DeliveryDateResult" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="httpClientResource"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/bw/models/sharedresource/httpclient}HttpClientConfiguration" type="xsd:string">
            <bpws:from>
                <bpws:literal>orderenrichment.Delivery</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns6:ActivityInput" name="LogDay-input" sca-bpel:internal="true"/>
        <bpws:variable name="i" type="xsd:int">
            <bpws:from>
                <bpws:literal>1</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns8:HolidaysRequest"
            name="CallHolidays-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:Holidays" name="CallHolidays" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:HolidaysRequest"
            name="CallHolidayNextYear-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:Holidays" name="CallHolidayNextYear" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns:OptionalErrorReport"
            name="_errorOptional" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallHolidays" tibex:linkType="SUCCESS"/>
                <bpws:link name="RepeatToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallHolidaysToCallHolidayNextYear" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallHolidaysToEmpty" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CallHolidayNextYearToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToRepeat" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallHolidaysToEmpty1" tibex:linkType="ERROR"/>
                <bpws:link name="Empty1ToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallHolidayNextYearToEmpty1" tibex:linkType="ERROR"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="17ff189c-df75-408f-8463-ae8da1d3d654"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallHolidays"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="13039819-2496-454d-8275-4bbcf0a704f9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/DeliveryDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;i&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;CallHolidayNextYear&quot;/>&lt;xsl:param name=&quot;CallHolidays&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns1:DeliveryDateResult>&lt;tns1:effectiveDeliveryDate>&lt;xsl:value-of select=&quot;$Start/tns1:requestedDeliveryDate + xsd:dayTimeDuration(concat('P', string($i - 1), 'D'))&quot;/>&lt;/tns1:effectiveDeliveryDate>&lt;tns1:deliveryShiftReason>&lt;xsl:value-of select=&quot;if ($i = 1) then 'NONE' else if (days-from-duration($Start/tns1:requestedDeliveryDate - xsd:date('1900-01-01')) mod 7 &amp;lt; 5) then 'HOLIDAY' else 'WEEKEND'&quot;/>&lt;/tns1:deliveryShiftReason>&lt;xsl:if test=&quot;if (not(exists($CallHolidays)) or (month-from-date($Start/tns1:requestedDeliveryDate) = 12 and not(exists($CallHolidayNextYear)))) then 'HOLIDAY_CHECK_SKIPPED' else ()&quot;>&lt;tns1:warnings>&lt;xsl:value-of select=&quot;if (not(exists($CallHolidays)) or (month-from-date($Start/tns1:requestedDeliveryDate) = 12 and not(exists($CallHolidayNextYear)))) then 'HOLIDAY_CHECK_SKIPPED' else ()&quot;/>&lt;/tns1:warnings>&lt;/xsl:if>&lt;/tns1:DeliveryDateResult>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Repeat" tibex:group="repeatUntil" tibex:xpdlId="b5556ac6-273c-408b-9748-79c0ea8c4fa7">
                <bpws:targets>
                    <bpws:target linkName="EmptyToRepeat"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatToEnd"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="repeatUntil">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:repeatUntil name="repeatUntil" tibex:counterName="i">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="days-from-duration(($Start/ns0:requestedDeliveryDate + xsd:dayTimeDuration(concat('P', string($i - 1), 'D'))) - xsd:date('1900-01-01')) mod 7 &lt; 5 and not(($Start/ns0:requestedDeliveryDate + xsd:dayTimeDuration(concat('P', string($i - 1), 'D'))) = $CallHolidays/ns7:holiday[ns7:global = true() and ns7:types = 'Public']/ns7:date) and (if (month-from-date($Start/ns0:requestedDeliveryDate) = 12) then not(($Start/ns0:requestedDeliveryDate + xsd:dayTimeDuration(concat('P', string($i - 1), 'D'))) = $CallHolidayNextYear/ns7:holiday[ns7:global = true() and ns7:types = 'Public']/ns7:date) else true())" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToLogDay" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="2d77dcdf-51f3-4c5c-9c27-28b0c2185fea">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToLogDay"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="796f7997-557d-4f57-aae7-47ac3d9bee42"/>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="LogDay-input"
                                    name="LogDay"
                                    tibex:xpdlId="adb7cd27-f9c0-456a-907f-77a4c6f3ec4e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToLogDay"/>
                                    </bpws:targets>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.example.org/DeliveryDate&quot; xmlns:ns7=&quot;http://www.example.org/HolidaysResponse&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;i&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogDay-input&quot; match=&quot;/&quot;>&lt;tns2:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat('Controllo giorno: ', string($Start/tns1:requestedDeliveryDate + xsd:dayTimeDuration(concat('P', string($i - 1), 'D'))))&quot;/>&lt;/message>&lt;/tns2:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value
                                    controlBy="Application"
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[days-from-duration(($Start/ns0:requestedDeliveryDate + xsd:dayTimeDuration(concat('P', string($i - 1), 'D'))) - xsd:date('1900-01-01')) mod 7 < 5 and not(($Start/ns0:requestedDeliveryDate + xsd:dayTimeDuration(concat('P', string($i - 1), 'D'))) = $CallHolidays/ns7:holiday[ns7:global = true() and ns7:types = 'Public']/ns7:date) and (if (month-from-date($Start/ns0:requestedDeliveryDate) = 12) then not(($Start/ns0:requestedDeliveryDate + xsd:dayTimeDuration(concat('P', string($i - 1), 'D'))) = $CallHolidayNextYear/ns7:holiday[ns7:global = true() and ns7:types = 'Public']/ns7:date) else true())]]></bpws:condition>
                    </bpws:repeatUntil>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="CallHolidays-input"
                    name="CallHolidays" outputVariable="CallHolidays"
                    tibex:xpdlId="2c1ee2b5-1f85-457a-a220-5c08306b50ee"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallHolidays"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallHolidaysToCallHolidayNextYear">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="month-from-date($Start/ns0:requestedDeliveryDate) = 12" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[month-from-date($Start/ns0:requestedDeliveryDate) = 12]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallHolidaysToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallHolidaysToEmpty1"
                            tibex:faultDetailsVar="CallHolidays" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/DeliveryDate&quot; xmlns:tns4=&quot;http://www.example.org/HolidaysRequest&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CallHolidays-input&quot; match=&quot;/&quot;>&lt;tns4:HolidaysRequest>&lt;tns4:countryCode>&lt;xsl:value-of select=&quot;$Start/tns1:countryCode&quot;/>&lt;/tns4:countryCode>&lt;tns4:year>&lt;xsl:value-of select=&quot;year-from-date($Start/tns1:requestedDeliveryDate)&quot;/>&lt;/tns4:year>&lt;/tns4:HolidaysRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="orderenrichment.At_Holidays" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="CallHolidayNextYear-input"
                    name="CallHolidayNextYear"
                    outputVariable="CallHolidayNextYear"
                    tibex:xpdlId="da16e15a-0742-4bce-9cbe-6af498f2f547"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallHolidaysToCallHolidayNextYear"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallHolidayNextYearToEmpty"/>
                        <bpws:source
                            linkName="CallHolidayNextYearToEmpty1"
                            tibex:faultDetailsVar="CallHolidayNextYear" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/DeliveryDate&quot; xmlns:tns4=&quot;http://www.example.org/HolidaysRequest&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CallHolidayNextYear-input&quot; match=&quot;/&quot;>&lt;tns4:HolidaysRequest>&lt;tns4:countryCode>&lt;xsl:value-of select=&quot;$Start/tns1:countryCode&quot;/>&lt;/tns4:countryCode>&lt;tns4:year>&lt;xsl:value-of select=&quot;year-from-date($Start/tns1:requestedDeliveryDate) + 1&quot;/>&lt;/tns4:year>&lt;/tns4:HolidaysRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="orderenrichment.At_Holidays" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="928304e7-165c-4a25-83b9-292f3d8e3e93">
                <bpws:targets>
                    <bpws:target linkName="CallHolidaysToEmpty"/>
