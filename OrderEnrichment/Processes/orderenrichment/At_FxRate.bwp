    xmlns:tibprop="http://ns.tibco.com/bw/property" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <tibex:VariableDescriptor type="MemorySaving">
        <task name="flow">
            <endingVariables>
                <variable>Start</variable>
            </endingVariables>
        </task>
        <task name="End">
            <endingVariables>
                <variable>ParseFxResponse</variable>
            </endingVariables>
        </task>
        <task name="Log">
            <endingVariables>
                <variable>Log-input</variable>
            </endingVariables>
        </task>
        <task name="GetFxRate">
            <endingVariables>
                <variable>GetFxRate-input</variable>
            </endingVariables>
        </task>
        <task name="ParseFxResponse">
            <endingVariables>
                <variable>ParseFxResponse-input</variable>
                <variable>GetFxRate</variable>
            </endingVariables>
        </task>
        <task name="ThrowFxError">
            <endingVariables>
                <variable>ThrowFxError-input</variable>
                <variable>_error_GetFxRate</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
