    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.keypartner.com/orderenrichment/ResolveError"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/ErrorResponse"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.keypartner.com/orderenrichment/InternalError"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ResolveErrorRequest" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:ResolveErrorResult" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="GetCorrelationId" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns1:InternalError"
            name="ResolveError-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:InternalError" name="ResolveError" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:ActivityInput" name="LogError-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ErrorResponse"
            name="BuildError-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ErrorResponse" name="BuildError" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToGetSharedVariable" tibex:linkType="SUCCESS"/>
                <bpws:link name="GetSharedVariableToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToMapper1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Mapper1ToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="e34cb60a-821b-4821-9962-14ec00970ff6"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToGetSharedVariable"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="454084c5-9860-458f-918d-2875c77bf71a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Mapper1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.keypartner.com/orderenrichment/ResolveError&quot; xmlns:tns1=&quot;http://www.keypartner.com/orderenrichment/InternalError&quot; xmlns:tns=&quot;http://www.example.org/ErrorResponse&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ResolveError&quot;/>&lt;xsl:param name=&quot;BuildError&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns3:ResolveErrorResult>&lt;tns3:httpStatus>&lt;xsl:value-of select=&quot;$ResolveError/tns1:httpStatus&quot;/>&lt;/tns3:httpStatus>&lt;tns:ErrorResponse>&lt;tns:code>&lt;xsl:value-of select=&quot;$BuildError/tns:code&quot;/>&lt;/tns:code>&lt;tns:message>&lt;xsl:value-of select=&quot;$BuildError/tns:message&quot;/>&lt;/tns:message>&lt;xsl:copy-of select=&quot;$BuildError/tns:details&quot;/>&lt;xsl:if test=&quot;$BuildError/tns:correlationId&quot;>&lt;tns:correlationId>&lt;xsl:value-of select=&quot;$BuildError/tns:correlationId&quot;/>&lt;/tns:correlationId>&lt;/xsl:if>&lt;/tns:ErrorResponse>&lt;/tns3:ResolveErrorResult>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity name="GetCorrelationId"
                    outputVariable="GetCorrelationId"
                    tibex:xpdlId="1327a2b9-1b58-4773-981f-6b06e6639706"
                    type="bw.internal.getSharedVariable" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToGetSharedVariable"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GetSharedVariableToMapper"/>
                    </bpws:sources>
                    <tibex:GetSharedVariable inline="true"
                        variableName="correlationId" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ResolveError-input"
                    name="ResolveError" outputVariable="ResolveError"
                    tibex:xpdlId="1040840c-74a1-479e-b223-cbaad096ccf6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetSharedVariableToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.keypartner.com/orderenrichment/InternalError&quot; xmlns:tns=&quot;http://www.example.org/ErrorResponse&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ResolveError-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:ErrorResponse/tns:code = 'VALIDATION_ERROR'&quot;>&lt;tns1:InternalError>&lt;tns1:internalCode>&lt;xsl:value-of select=&quot;'OE-001'&quot;/>&lt;/tns1:internalCode>&lt;tns1:httpStatus>&lt;xsl:value-of select=&quot;400&quot;/>&lt;/tns1:httpStatus>&lt;/tns1:InternalError>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:ErrorResponse/tns:code = 'INVALID_CURRENCY'&quot;>&lt;tns1:InternalError>&lt;tns1:internalCode>&lt;xsl:value-of select=&quot;'OE-002'&quot;/>&lt;/tns1:internalCode>&lt;tns1:httpStatus>&lt;xsl:value-of select=&quot;400&quot;/>&lt;/tns1:httpStatus>&lt;/tns1:InternalError>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:ErrorResponse/tns:code = 'UPSTREAM_FX_UNAVAILABLE'&quot;>&lt;tns1:InternalError>&lt;tns1:internalCode>&lt;xsl:value-of select=&quot;'OE-003'&quot;/>&lt;/tns1:internalCode>&lt;tns1:httpStatus>&lt;xsl:value-of select=&quot;502&quot;/>&lt;/tns1:httpStatus>&lt;/tns1:InternalError>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:InternalError>&lt;tns1:internalCode>&lt;xsl:value-of select=&quot;'OE-999'&quot;/>&lt;/tns1:internalCode>&lt;tns1:httpStatus>&lt;xsl:value-of select=&quot;500&quot;/>&lt;/tns1:httpStatus>&lt;/tns1:InternalError>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:InternalError="http://www.keypartner.com/orderenrichment/InternalError"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="InternalError:InternalError" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogError-input"
                    name="LogError"
                    tibex:xpdlId="aa797558-7d59-49d3-a318-37655367aa32" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToMapper1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.keypartner.com/orderenrichment/InternalError&quot; xmlns:tns=&quot;http://www.example.org/ErrorResponse&quot; xmlns:tns3=&quot;http://www.keypartner.com/orderenrichment/ResolveError&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GetCorrelationId&quot;/>&lt;xsl:param name=&quot;ResolveError&quot;/>&lt;xsl:template name=&quot;LogError-input&quot; match=&quot;/&quot;>&lt;tns2:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat('[', $GetCorrelationId, '] ',$ResolveError/tns1:internalCode, ' ', $Start/tns3:technicalMessage)&quot;/>&lt;/message>&lt;/tns2:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value controlBy="Application"
                                    role="Error"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="BuildError-input" name="BuildError"
                    outputVariable="BuildError"
                    tibex:xpdlId="d1b1a946-5424-4c9c-b37a-262239b64523" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToMapper1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Mapper1ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ErrorResponse&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GetCorrelationId&quot;/>&lt;xsl:template name=&quot;BuildError-input&quot; match=&quot;/&quot;>&lt;tns:ErrorResponse>&lt;tns:code>&lt;xsl:value-of select=&quot;$Start/tns:ErrorResponse/tns:code&quot;/>&lt;/tns:code>&lt;tns:message>&lt;xsl:value-of select=&quot;$Start/tns:ErrorResponse/tns:message&quot;/>&lt;/tns:message>&lt;xsl:copy-of select=&quot;$Start/tns:ErrorResponse/tns:details&quot;/>&lt;tns:correlationId>&lt;xsl:value-of select=&quot;$GetCorrelationId&quot;/>&lt;/tns:correlationId>&lt;/tns:ErrorResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:ErrorResponse="http://www.example.org/ErrorResponse"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ErrorResponse:ErrorResponse" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
