<?xml version="1.0" encoding="UTF-8"?>
<bpws:process exitOnStandardFault="no"
    name="orderenrichment.At_Holidays" suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20261008181901"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:bw="http://www.tibco.com/bw/xpath/bw-custom-functions"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns0="http://www.example.org/HolidaysRequest"
    xmlns:ns1="http://www.example.org/HolidaysResponse"
    xmlns:ns2="http://www.tibco.com/pe/WriteToLogActivitySchema"
    xmlns:ns3="http://tns.tibco.com/bw/activity/sendhttprequest/input+68a27375-0c57-466b-b7c1-f605f63ca45c+RequestActivityInput"
    xmlns:ns4="http://tns.tibco.com/bw/activity/sendhttprequest/output+68a27375-0c57-466b-b7c1-f605f63ca45c+RequestActivityOutput"
    xmlns:ns5="http://tns.tibco.com/bw/palette/internal/activityerror+bw.http.sendHTTPRequest"
    xmlns:ns6="activity.jsonParser.input+066741b8-2d38-439d-bf7c-e58a4094ebee+ActivityInputType"
    xmlns:ns7="http://tns.tibco.com/bw/palette/internal/activityerror+bw.restjson.JsonParser"
    xmlns:ns8="http://www.example.org/HolidaysCache"
    xmlns:ns9="http://tns.tibco.com/bw/activity/sleep/xsd"
    xmlns:sca="http://docs.oasis-open.org/ns/opencsa/sca/200912"
    xmlns:sca-bpel="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"
    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"
    xmlns:tibprop="http://ns.tibco.com/bw/property" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <tibex:VariableDescriptor type="MemorySaving">
        <task name="End">
            <endingVariables>
                <variable>Start</variable>
                <variable>ParseHoliday</variable>
                <variable>GetCache</variable>
            </endingVariables>
        </task>
        <task name="ParseHoliday">
            <endingVariables>
                <variable>ParseHoliday-input</variable>
                <variable>getHoliday</variable>
            </endingVariables>
        </task>
        <task name="WritheCache">
            <endingVariables>
                <variable>WritheCache-input</variable>
                <variable>WritheCache</variable>
                <variable>ReadCache</variable>
            </endingVariables>
        </task>
        <task name="RetryNager">
            <endingVariables>
                <variable>i</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="SleepNager">
            <endingVariables>
                <variable>SleepNager-input</variable>
            </endingVariables>
        </task>
        <task name="Log">
            <endingVariables>
                <variable>Log-input</variable>
            </endingVariables>
        </task>
        <task name="getHoliday">
            <endingVariables>
                <variable>getHoliday-input</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
    <tibex:Types>
        <xs:schema attributeFormDefault="unqualified"
            elementFormDefault="qualified"
            targetNamespace="http://www.tibco.com/pe/EngineTypes"
            xmlns:tns="http://www.tibco.com/pe/EngineTypes" xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:complexType block="extension restriction"
                final="extension restriction" name="ErrorReport">
