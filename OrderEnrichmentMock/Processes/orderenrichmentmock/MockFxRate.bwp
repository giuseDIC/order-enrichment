&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://xmlns.example.com/20261008105019PLT" xmlns:tns="http://www.example.org/FxResponse" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:template name="getOut-input" match="/"&gt;&lt;tns1:getResponse&gt;&lt;item&gt;&lt;tns:FxResponse&gt;&lt;tns:amount&gt;&lt;xsl:value-of select="1.0"/&gt;&lt;/tns:amount&gt;&lt;tns:base&gt;&lt;xsl:value-of select="&amp;quot;USD&amp;quot;"/&gt;&lt;/tns:base&gt;&lt;tns:date&gt;&lt;xsl:value-of select="xsd:date('2026-10-02')"/&gt;&lt;/tns:date&gt;&lt;tns:rates&gt;&lt;tns:EUR&gt;&lt;xsl:value-of select="0.9091"/&gt;&lt;/tns:EUR&gt;&lt;/tns:rates&gt;&lt;/tns:FxResponse&gt;&lt;/item&gt;&lt;/tns1:getResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
